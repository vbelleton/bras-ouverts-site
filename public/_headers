# L'espace équipe ne doit être ni indexé ni gardé en cache.
/inscriptions
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Cross-Origin-Opener-Policy: same-origin-allow-popups
/inscriptions/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Cross-Origin-Opener-Policy: same-origin-allow-popups
/api/*
  Cache-Control: no-store
# Le service worker et le manifeste de l'appli doivent toujours être relus (sinon une mise à jour tarde des jours).
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
